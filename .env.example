# Copy this file to .env for local development. Never commit real credentials.
APP_ENV=development
APP_TIMEZONE=Asia/Taipei
FRONTEND_DIST_DIR=frontend/dist

# Added in M2. Use only public/local placeholders here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# Browser-visible Supabase credentials. Use only the public anon/publishable key;
# never expose a service-role key through a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_REQUEST_ROLE=authenticated
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=0

# Disposable local PostgreSQL URL used only by M2 integration tests.
M2_TEST_DATABASE_URL=postgresql+psycopg://postgres:shiftmate_local_only@localhost:5432/shiftmate_test

# Added in M4. Keep the real key in a local or platform secret store.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_SECONDS=30
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.55
UPLOAD_MAX_BYTES=5242880
UPLOAD_PDF_MAX_PAGES=40
UPLOAD_DAILY_CAP_PER_OWNER=10
GEMINI_DAILY_REQUEST_CAP=50
API_RATE_LIMIT_PER_MINUTE=120

# Added in M7. Keep client secrets outside the repository.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Use two different randomly generated values of at least 32 characters.
GOOGLE_OAUTH_STATE_SECRET=
CALENDAR_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_TIMEOUT_SECONDS=15

# Added in M8. HTTP requests use the normal Supabase bearer token. The stdio
# process reads this token only from its environment; never place a real value
# in a committed file.
SHIFTMATE_MCP_ACCESS_TOKEN=
MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*"]
MCP_ALLOWED_ORIGINS=["http://127.0.0.1:*","http://localhost:*"]

# Added in M9. Production values are injected from the platform configuration;
# placeholders intentionally do not authorize the maintenance endpoint.
SCHEDULER_OIDC_AUDIENCE=
SCHEDULER_SERVICE_ACCOUNT_EMAIL=
SCHEDULER_JOB_NAME=daily-maintenance
DATABASE_MAINTENANCE_ROLE=shiftmate_maintenance
MAINTENANCE_DRAFT_TTL_DAYS=7
MAINTENANCE_RETENTION_DAYS=30
