# Copy this file to .env for local development. Never commit real credentials.
APP_ENV=development
APP_TIMEZONE=Asia/Taipei
FRONTEND_DIST_DIR=frontend/dist

# Added in M2. Use only public/local placeholders here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
DATABASE_URL=

# Added in M4. Keep the real key in a local or platform secret store.
GEMINI_API_KEY=

# Added in M7. Keep client secrets outside the repository.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
